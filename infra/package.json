{
  "name": "weight-fitness-app-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "weight-fitness-app のAWS CDKスタック（デプロイはユーザーが別PCで実行）",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "pretypecheck": "node ../scripts/check-node.mjs",
