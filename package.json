{
  "name": "weight-fitness-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "体重・運動・デイリーミッション・食事画像をカレンダーで管理するWebアプリ",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "vite",
    "dev:api": "tsx src/api/dev-server.ts",
    "check:node": "node scripts/check-node.mjs",
    "pretypecheck": "node scripts/check-node.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/check-node.mjs",
    "test": "vitest run",
    "build:web": "vite build",
    "build:api": "node scripts/build-api.mjs",
    "build": "npm run typecheck && npm run build:web && npm run build:api"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "jsdom": "27.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
}
